    <Node ToolID="4">
      <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
        <Position x="462" y="246"/>
      </GuiSettings>
      <Properties>
        <Configuration>
          <FormulaFields>
            <FormulaField expression="ToNumber([source_a_amount]) - ToNumber([source_b_amount])" field="difference" size="8" type="Double"/>
            <FormulaField expression="Abs([difference])" field="absolute_difference" size="8" type="Double"/>
            <FormulaField expression="IIF([absolute_difference] &lt;= 5, &quot;ACCEPTED&quot;, &quot;REVIEW&quot;)" field="review_status" size="20" type="V_String"/>
          </FormulaFields>
        </Configuration>
        <Annotation DisplayMode="0">
          <Name/>
          <DefaultAnnotationText>Difference, absolute difference, and synthetic review status</DefaultAnnotationText>
          <Left value="False"/>
        </Annotation>
      </Properties>
      <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula"/>
    </Node>
